---
import Seo from '@/components/seo/Seo.astro';
import SiteHeader from '@/components/chrome/SiteHeader.astro';
import SiteFooter from '@/components/chrome/SiteFooter.astro';
import ToTop from '@/components/chrome/ToTop.astro';
import Lightbox from '@/components/ui/Lightbox.astro';
import { themeInitScript } from '@/lib/theme-init';
import { assets, legalNavigation, navigation, site } from '@/data/site';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: readonly Record<string, unknown>[];
  lightboxTitle?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  path,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd = [],
  lightboxTitle = '应用界面',
  bodyClass,
} = Astro.props;

const isHome = path === '/';
const homeHref = isHome ? '' : '/';

const headerLabels = {
  homeHref,
  brand: site.name,
  tagline: site.shortDescription,
  menu: '菜单',
  close: '关闭菜单',
  themeGroup: '显示主题',
  themeLight: '浅色',
  themeDark: '深色',
  themeSystem: '跟随系统',
  cta: '查看界面',
  iconSrc: assets.mark,
};
---

<!doctype html>
<html lang="zh-CN" data-theme-preference="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline set:html={themeInitScript} />
    <Seo
      title={title}
      description={description}
      path={path}
      type={type}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      jsonLd={jsonLd}
    />
  </head>
  <body class={bodyClass} id="top">
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>

    <a class="skip-link" href="#main">
      跳到主要内容
    </a>

    <SiteHeader navigation={navigation} legalNavigation={legalNavigation} labels={headerLabels} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter homeHref={headerLabels.homeHref} iconSrc={assets.mark} />

    <ToTop />
    <Lightbox title={lightboxTitle} groupLabel="查看大图" />

    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>
