---
/**
 * iPhone 13 Pro Max · 苍岭绿设备框。
 *
 * 极简“边到边”方案：截图完整铺满屏幕区域，仅保留窄苍岭绿金属边框与圆角。
 * 不叠加黑色面板、刘海或侧键，避免任何黑边与图片遮挡。
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={['device-frame', className]}
  data-device-model="iphone-13-pro-max"
  data-device-finish="alpine-green"
>
  <div class="device-frame__screen">
    <slot />
  </div>
</div>
