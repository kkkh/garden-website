---
/**
 * 截图卡片。
 *
 * 不再模拟手机壳：不设固定宽高比容器、不使用 object-fit: cover，
 * 图片按 1284×2778 原始比例自然撑开，100% 完整展示，零裁切。
 * 仅保留圆角、发丝内高光与分层环境阴影。
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={['screenshot-card', className]}
  data-device-model="iphone-13-pro-max"
  data-device-finish="alpine-green"
>
  <slot />
</div>
