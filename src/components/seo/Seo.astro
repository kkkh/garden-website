---
import { assets, site } from '@/data/site';
import { metaColors } from '@/design/tokens';

interface Props {
  title: string;
  description: string;
  path: string;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: readonly Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  type = 'website',
  image = assets.ogImage,
  imageAlt = `${site.name} · ${site.shortDescription}`,
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(path, site.domain).href;
const ogImage = new URL(image, site.domain).href;
const fullTitle = path === '/' ? title : `${title} · ${site.name}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="author" content={site.author} />
<meta name="keywords" content={site.keywords.join(', ')} />
<meta name="theme-color" content={site.themeColor} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={metaColors.dark} media="(prefers-color-scheme: dark)" />
<meta name="format-detection" content="telephone=no" />

<link rel="icon" href={assets.favicon} sizes="32x32" type="image/png" />
<link rel="icon" href={assets.faviconSvg} type="image/svg+xml" />
<link rel="apple-touch-icon" href={assets.appleTouchIcon} sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(assets.ogImageWidth)} />
<meta property="og:image:height" content={String(assets.ogImageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
