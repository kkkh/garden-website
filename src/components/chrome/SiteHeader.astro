---
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import Icon from '@/components/ui/Icon.astro';
import MobileNav from '@/components/chrome/MobileNav.astro';
import type { LegalNavigationItem, NavigationItem } from '@/data/site';

interface Props {
  navigation: readonly NavigationItem[];
  legalNavigation: readonly LegalNavigationItem[];
  labels: {
    homeHref: string;
    brand: string;
    tagline: string;
    menu: string;
    close: string;
    themeGroup: string;
    themeLight: string;
    themeDark: string;
    themeSystem: string;
    cta: string;
    iconSrc: string;
  };
}

const { navigation, legalNavigation, labels } = Astro.props;

const resolve = (href: string) => (href.startsWith('#') ? `${labels.homeHref}${href}` : href);
---

<header class="site-header" data-site-header>
  <div class="container container--wide header__bar">
    <a class="brand" href={resolve('#top')} aria-label={`${labels.brand} ${labels.tagline}`}>
      <img src={labels.iconSrc} alt="" width="34" height="34" loading="eager" decoding="async" />
      <span class="brand__name">{labels.brand}</span>
      <span class="brand__meta">{labels.tagline}</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      <ul>
        {navigation.map((item) => (
          <li>
            <a
              href={resolve(item.href)}
              data-nav-link
              data-nav-section={item.id}
              data-track="nav:click"
              data-track-label={item.label}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <ThemeToggle
        groupLabel={labels.themeGroup}
        labels={{
          light: labels.themeLight,
          dark: labels.themeDark,
          system: labels.themeSystem,
        }}
      />

      <a
        class="button button--sm button--outline header__cta"
        href={resolve('#screenshots')}
        data-track="cta:click"
        data-track-label={labels.cta}
      >
        {labels.cta}
      </a>

      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-haspopup="dialog"
      >
        <Icon name="menu" size={16} />
        <span>{labels.menu}</span>
      </button>
    </div>
  </div>
</header>

<MobileNav
  navigation={navigation}
  legalNavigation={legalNavigation}
  labels={{
    brand: labels.brand,
    close: labels.close,
    homeHref: labels.homeHref,
    tagline: labels.tagline,
  }}
/>

<script>
  import '@/scripts/app';
</script>
