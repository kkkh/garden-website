---
import { getCollection, render } from 'astro:content';
import GithubSlugger from 'github-slugger';
import LegalLayout from '@/layouts/LegalLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Heading {
  id: string;
  text: string;
}

export async function getStaticPaths() {
  const entries = await getCollection('legal');
  return entries.map((entry: CollectionEntry<'legal'>) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

/**
 * 目录锚点与 rehype-slug 使用同一套 slug 算法（github-slugger），
 * 并按出现顺序去重，保证与构建产物中的 `h2[id]` 完全一致。
 */
const slugger = new GithubSlugger();
const headings: Heading[] = Array.from(entry.body?.matchAll(/^##\s+(.+)$/gm) ?? []).map((match) => {
  const text = (match[1] ?? '').trim();
  return { id: slugger.slug(text), text };
});

const path = `/${entry.id}.html`;
---

<LegalLayout
  title={entry.data.title}
  description={entry.data.description}
  summary={entry.data.summary}
  path={path}
  effectiveDate={entry.data.effectiveDate}
  updatedDate={entry.data.updatedDate}
  headings={headings}
>
  <Content />
</LegalLayout>
